---
const jobs = [
  {
    company: 'Dexcom',
    role: 'Senior Software Engineer',
    period: '2022 — Present',
    location: 'San Diego, CA',
    description:
      'Built backend services for the Dexcom CGM platform handling millions of glucose readings per day. Led design of a real-time alerting pipeline using Kafka and Go, reducing alert latency by 60%. Collaborated closely with hardware and clinical teams to ship FDA-cleared software.',
    tags: ['Go', 'Kafka', 'PostgreSQL', 'AWS', 'Kubernetes'],
  },
  {
    company: 'Accenture',
    role: 'Machine Learning Engineer',
    period: '2020 — 2022',
    location: 'Chicago, IL',
    description:
      'Developed ML pipelines for Fortune 500 clients across healthcare and finance verticals. Productionized NLP models for document classification and entity extraction, achieving 92% accuracy on real-world datasets. Championed MLOps practices including model versioning and A/B testing infrastructure.',
    tags: ['Python', 'PyTorch', 'MLflow', 'Azure', 'FastAPI'],
  },
  {
    company: 'University of Illinois',
    role: 'Research Assistant — NLP Lab',
    period: '2018 — 2020',
    location: 'Urbana-Champaign, IL',
    description:
      'Conducted research in low-resource NLP, focusing on cross-lingual transfer learning for underrepresented languages. Co-authored a paper on multilingual BERT fine-tuning accepted at ACL Workshop 2020. Built and maintained a shared compute cluster for the lab.',
    tags: ['Python', 'PyTorch', 'HuggingFace', 'Linux'],
  },
];
---

<section id="experience" class="py-24 px-6 bg-[var(--bg-secondary)]">
  <div class="max-w-5xl mx-auto">
    <div class="reveal mb-12">
      <h2 class="text-xs font-mono text-accent uppercase tracking-widest mb-4">Experience</h2>
      <h3 class="text-3xl font-bold">Where I've worked</h3>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-4 md:left-6 top-2 bottom-2 w-px bg-[var(--border)]"></div>

      <div class="space-y-12">
        {jobs.map((job, i) => (
          <div class={`reveal pl-12 md:pl-16 relative`} style={`transition-delay: ${i * 0.12}s`}>
            <!-- Timeline dot -->
            <div class="timeline-dot absolute left-2.5 md:left-4 top-1.5 w-3 h-3 rounded-full bg-accent border-2 border-[var(--bg-secondary)]"></div>

            <div class="group">
              <!-- Header -->
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 mb-2">
                <h4 class="text-lg font-semibold">{job.role}</h4>
                <span class="text-muted text-sm">@</span>
                <span class="text-accent font-medium">{job.company}</span>
              </div>

              <div class="flex flex-wrap gap-3 text-xs font-mono text-muted mb-3">
                <span>{job.period}</span>
                <span>·</span>
                <span>{job.location}</span>
              </div>

              <p class="text-muted leading-relaxed mb-4">{job.description}</p>

              <div class="flex flex-wrap gap-2">
                {job.tags.map((tag) => (
                  <span class="text-xs font-mono px-2 py-0.5 rounded border border-site text-muted">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
