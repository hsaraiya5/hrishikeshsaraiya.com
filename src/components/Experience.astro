---
const jobs = [
  {
    company: 'Upstart',
    role: 'Software Engineer, ML Platform',
    period: 'Dec 2025 — Present',
    location: 'Arlington, VA (Remote)',
    logo: '/images/upstart.png',
    description:
      'Upstart is an AI lending platform that uses machine learning to go beyond the FICO score in assessing credit risk. I sit on the ML Platform team, building the infrastructure and tooling that enables data scientists to train, validate, simulate, and deploy the models powering Upstart\'s borrower application process.',
    tags: ['Python', 'Kubernetes', 'Metaflow'],
  },
  {
    company: 'Capital One',
    role: 'Software Engineer, ML Platforms',
    period: 'Aug 2021 — Nov 2025',
    location: 'McLean, VA',
    logo: '/images/capitalone.png',
    subroles: [
      {
        title: 'Enterprise Model Platform',
        description:
          'Built platform capabilities powering the full ML lifecycle — training, pipelines, deployment, and reusable SDKs — used by hundreds of data scientists across the company. Was a core member of the air-gapped pilot deployment of Weights & Biases on Capital One\'s Kubernetes infrastructure, driving enterprise adoption at launch. Developed a Python ML component framework that decoupled ML code from orchestration engines, becoming the standard for Kubeflow Pipelines component development company-wide. Core contributor to SDK standards on Capital One\'s Generative AI Platform.',
      },
      {
        title: 'Data Insights Platform',
        description:
          'MLOps and SRE for Capital One Data Insights, an enterprise ML workflow orchestration platform. Maintained a Kubernetes fleet on AWS supporting data scientists\' ML workflow jobs — infrastructure that cumulatively saves the enterprise $100M+ annually. Contributed to a mirror fleet for a commercial offering of the platform. Improved observability through a Python logging framework with OpenTelemetry and New Relic trace injection, and added CPU/GPU and memory monitoring for high-impact workloads.',
      },
    ],
    tags: ['Python', 'Docker', 'Kubernetes', 'AWS', 'Weights & Biases', 'Kubeflow', 'OpenTelemetry', 'New Relic', 'SRE', 'MLOps'],
  },
];
---

<section id="experience" class="py-24 px-6 bg-[var(--bg-secondary)]">
  <div class="max-w-5xl mx-auto">
    <div class="reveal mb-12">
      <h2 class="text-xs font-mono text-accent uppercase tracking-widest mb-4">Experience</h2>
      <h3 class="text-3xl font-bold">Where I've worked</h3>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-4 md:left-6 top-2 bottom-2 w-px bg-[var(--border)]"></div>

      <div class="space-y-12">
        {jobs.map((job, i) => (
          <div class="reveal pl-12 md:pl-16 relative" style={`transition-delay: ${i * 0.12}s`}>
            <!-- Timeline dot -->
            <div class="timeline-dot absolute left-2.5 md:left-4 top-1.5 w-3 h-3 rounded-full bg-accent border-2 border-[var(--bg-secondary)]"></div>

            <div class="group">
              <!-- Header row: logo + title -->
              <div class="flex items-center gap-3 mb-1">
                <div class="w-8 h-8 rounded-lg bg-white flex items-center justify-center shadow-sm shrink-0 overflow-hidden">
                  <img
                    src={job.logo}
                    alt={job.company}
                    class="object-contain w-full h-full p-0.5"
                  />
                </div>
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3">
                  <h4 class="text-lg font-semibold leading-tight">{job.role}</h4>
                  <span class="text-muted text-sm hidden sm:inline">@</span>
                  <span class="text-accent font-medium">{job.company}</span>
                </div>
              </div>

              <!-- Meta -->
              <div class="flex flex-wrap gap-3 text-xs font-mono text-muted mb-4 ml-11">
                <span>{job.period}</span>
                <span>·</span>
                <span>{job.location}</span>
              </div>

              <!-- Single description -->
              {job.description && (
                <p class="text-muted leading-relaxed mb-4">{job.description}</p>
              )}

              <!-- Sub-roles -->
              {job.subroles && (
                <div class="space-y-5 mb-4">
                  {job.subroles.map((sub) => (
                    <div class="pl-4 border-l-2 border-[var(--border)]">
                      <h5 class="text-sm font-semibold mb-1.5">{sub.title}</h5>
                      <p class="text-muted text-sm leading-relaxed">{sub.description}</p>
                    </div>
                  ))}
                </div>
              )}

              <!-- Tags -->
              <div class="flex flex-wrap gap-2">
                {job.tags.map((tag) => (
                  <span class="text-xs font-mono px-2 py-0.5 rounded border border-site text-muted">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
