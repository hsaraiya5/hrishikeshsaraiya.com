---
const projects = [
  {
    name: 'CGM Dashboard',
    description:
      'Real-time continuous glucose monitoring dashboard with predictive alerts, trend analysis, and a macOS menu bar app. Integrates with the Dexcom Share API.',
    tags: ['Swift', 'Python', 'FastAPI', 'WebSocket', 'PostgreSQL'],
    github: 'https://github.com/hsaraiya5/cgm-dashboard',
    color: '#6366f1',
  },
  {
    name: 'Tensor Cache',
    description:
      'A Redis-backed embedding cache for ML inference pipelines. Reduces redundant embedding computation by 80% in production RAG workloads.',
    tags: ['Python', 'Redis', 'PyTorch', 'FastAPI'],
    github: 'https://github.com/hsaraiya5/tensor-cache',
    color: '#8b5cf6',
  },
  {
    name: 'QueryForge',
    description:
      'Natural language to SQL query translator using fine-tuned LLMs. Supports PostgreSQL, MySQL, and SQLite with schema-aware context injection.',
    tags: ['Python', 'HuggingFace', 'SQLAlchemy', 'Streamlit'],
    github: 'https://github.com/hsaraiya5/queryforge',
    color: '#06b6d4',
  },
  {
    name: 'Distributed Task Queue',
    description:
      'A lightweight, Redis-backed task queue in Go with priority scheduling, retries with exponential backoff, and a web UI for monitoring.',
    tags: ['Go', 'Redis', 'Docker', 'HTMX'],
    github: 'https://github.com/hsaraiya5/dtq',
    color: '#10b981',
  },
  {
    name: 'LogLens',
    description:
      'Structured log analysis tool that uses ML to detect anomalies, cluster error patterns, and surface actionable insights from high-volume log streams.',
    tags: ['Python', 'scikit-learn', 'Kafka', 'Elasticsearch'],
    github: 'https://github.com/hsaraiya5/loglens',
    color: '#f59e0b',
  },
  {
    name: 'PersonalFinance CLI',
    description:
      'Terminal-based personal finance tracker that syncs with bank accounts via Plaid, categorises transactions with ML, and generates monthly reports.',
    tags: ['Python', 'Plaid API', 'SQLite', 'Rich'],
    github: 'https://github.com/hsaraiya5/pf-cli',
    color: '#ef4444',
  },
];
---

<section id="projects" class="py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="reveal mb-12">
      <h2 class="text-xs font-mono text-accent uppercase tracking-widest mb-4">Projects</h2>
      <h3 class="text-3xl font-bold">Things I've built</h3>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map((project, i) => (
        <div
          class="project-card reveal group relative flex flex-col p-6 rounded-xl border border-site bg-[var(--bg-secondary)] hover:border-[var(--accent)] transition-all duration-300 cursor-default"
          style={`transition-delay: ${i * 0.08}s`}
          data-tilt
        >
          <!-- Glow dot -->
          <div
            class="w-2 h-2 rounded-full mb-4 opacity-80"
            style={`background-color: ${project.color}`}
          ></div>

          <!-- Name + GitHub link -->
          <div class="flex items-start justify-between gap-2 mb-3">
            <h4 class="font-semibold text-base leading-snug group-hover:text-accent transition-colors">
              {project.name}
            </h4>
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`GitHub: ${project.name}`}
              class="shrink-0 text-muted hover:text-[var(--text)] transition-colors mt-0.5"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>
          </div>

          <p class="text-sm text-muted leading-relaxed flex-1 mb-4">
            {project.description}
          </p>

          <div class="flex flex-wrap gap-1.5 mt-auto">
            {project.tags.map((tag) => (
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-[var(--bg)] border border-site text-muted">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // 3D tilt effect on project cards
  document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const cx = rect.width / 2;
      const cy = rect.height / 2;
      const rotateX = ((y - cy) / cy) * -6;
      const rotateY = ((x - cx) / cx) * 6;
      card.style.transform = `perspective(600px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(600px) rotateX(0) rotateY(0) scale(1)';
    });
  });
</script>
