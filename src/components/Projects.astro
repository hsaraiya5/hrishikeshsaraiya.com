---
const featured = {
  name: 'Dexcom G7 macOS Menubar App',
  description:
    'A lightweight macOS menubar app for monitoring Dexcom G7 CGM readings in real-time. Displays your current glucose value and trend arrow directly in the menubar with color-coded status indicators — green for in-range, red for low, orange/yellow for high. Includes smart notifications for low and high alerts (with a 15-minute cooldown to avoid spam), a recent history dropdown showing the last 12 readings, and automatic updates every 5 minutes. Credentials are stored securely in the macOS Keychain.',
  tags: ['Python', 'macOS', 'Dexcom Share API', 'macOS Keychain'],
  github: 'https://github.com/hsaraiya5/dexcom-menubar-app',
  color: '#0096D6',
  highlights: [
    'Color-coded glucose status with trend arrows (⬆⬆ → ⬇⬇)',
    'Smart alerts for lows and highs with throttled notifications',
    'Auto-refreshes every 5 minutes, manual refresh on demand',
    'Secure credential storage via macOS Keychain',
  ],
};
---

<section id="projects" class="py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="reveal mb-12">
      <h2 class="text-xs font-mono text-accent uppercase tracking-widest mb-4">Projects</h2>
      <h3 class="text-3xl font-bold">Things I've built</h3>
    </div>

    <!-- Featured project -->
    <div class="reveal">
      <div
        class="group relative rounded-2xl border border-site bg-[var(--bg-secondary)] p-8 sm:p-10 transition-all duration-300 hover:border-[var(--accent)]"
        data-tilt
      >
        <!-- Top row -->
        <div class="flex items-start justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <!-- Colour dot -->
            <span
              class="w-3 h-3 rounded-full shrink-0"
              style={`background-color: ${featured.color}`}
            ></span>
            <h4 class="text-xl font-semibold group-hover:text-accent transition-colors">
              {featured.name}
            </h4>
          </div>
          <a
            href={featured.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="shrink-0 text-muted hover:text-[var(--text)] transition-colors"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
        </div>

        <!-- Description + highlights side by side on larger screens -->
        <div class="grid sm:grid-cols-2 gap-8">
          <p class="text-muted leading-relaxed text-sm">
            {featured.description}
          </p>

          <ul class="space-y-2">
            {featured.highlights.map((h) => (
              <li class="flex items-start gap-2 text-sm text-muted">
                <span class="mt-1 w-1.5 h-1.5 rounded-full shrink-0" style={`background-color: ${featured.color}`}></span>
                {h}
              </li>
            ))}
          </ul>
        </div>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mt-8">
          {featured.tags.map((tag) => (
            <span class="text-xs font-mono px-2 py-0.5 rounded border border-site text-muted">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- More coming soon -->
    <p class="reveal text-xs font-mono text-muted mt-8 text-center" style="transition-delay: 0.1s">
      more coming soon —
      <a href="https://github.com/hsaraiya5" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline underline-offset-4">
        follow along on GitHub
      </a>
    </p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const cx = rect.width / 2;
      const cy = rect.height / 2;
      const rotateX = ((y - cy) / cy) * -4;
      const rotateY = ((x - cx) / cx) * 4;
      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.01)`;
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(800px) rotateX(0) rotateY(0) scale(1)';
    });
  });
</script>
