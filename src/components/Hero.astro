---
---

<section
  id="hero"
  class="hero-gradient min-h-screen flex flex-col items-center justify-center px-6 relative overflow-hidden"
>
  <!-- Noise texture overlay -->
  <div
    class="absolute inset-0 opacity-[0.03] dark:opacity-[0.06] pointer-events-none"
    style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22><filter id=%22noise%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22/><feColorMatrix type=%22saturate%22 values=%220%22/></filter><rect width=%22200%22 height=%22200%22 filter=%22url(%23noise)%22/></svg>')"
  ></div>

  <!-- Terminal window -->
  <div class="relative z-10 w-full max-w-4xl">
    <!-- Window chrome -->
    <div class="flex items-center gap-2 px-4 py-3 bg-[var(--bg-secondary)] border border-site rounded-t-xl border-b-0">
      <span class="w-3 h-3 rounded-full bg-red-400"></span>
      <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
      <span class="w-3 h-3 rounded-full bg-green-400"></span>
      <span class="ml-3 text-xs font-mono text-muted">hrishikesh ~ zsh</span>
    </div>

    <!-- Terminal body -->
    <div class="bg-[var(--bg-secondary)] border border-site rounded-b-xl px-10 py-12 font-mono text-base leading-relaxed">

      <!-- whoami block -->
      <div class="mb-6">
        <div class="flex items-center gap-2 text-muted mb-1">
          <span class="text-green-500 dark:text-green-400">➜</span>
          <span class="text-accent">~</span>
          <span>whoami</span>
        </div>
        <div class="pl-0 text-3xl sm:text-4xl font-bold text-[var(--text)] tracking-tight">
          Hrishikesh Saraiya
        </div>
      </div>

      <!-- role block with typewriter -->
      <div class="mb-6">
        <div class="flex items-center gap-2 text-muted mb-1">
          <span class="text-green-500 dark:text-green-400">➜</span>
          <span class="text-accent">~</span>
          <span>cat role.txt</span>
        </div>
        <div class="text-[var(--text)] flex items-center gap-0.5 min-h-[1.5rem]">
          <span id="typewriter" class="text-accent font-semibold"></span>
          <span id="cursor" class="inline-block w-2 h-5 bg-accent align-middle ml-0.5"></span>
        </div>
      </div>

      <!-- location / status block -->
      <div class="mb-8">
        <div class="flex items-center gap-2 text-muted mb-1">
          <span class="text-green-500 dark:text-green-400">➜</span>
          <span class="text-accent">~</span>
          <span>cat status.txt</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 text-muted">
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
            Software Engineer @ Upstart
          </span>
          <span class="hidden sm:inline text-[var(--border)]">|</span>
          <span>Arlington, VA</span>
        </div>
      </div>

      <!-- CTA block -->
      <div class="border-t border-site pt-6">
        <div class="flex items-center gap-2 text-muted mb-3">
          <span class="text-green-500 dark:text-green-400">➜</span>
          <span class="text-accent">~</span>
          <span>ls ./links</span>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/#projects"
            class="px-4 py-2 rounded-lg text-xs font-mono border border-site hover:border-[var(--accent)] hover:text-accent transition-colors"
          >
            ./projects
          </a>
          <a
            href="/blog"
            class="px-4 py-2 rounded-lg text-xs font-mono border border-site hover:border-[var(--accent)] hover:text-accent transition-colors"
          >
            ./blog
          </a>
          <a
            href="/#about"
            class="px-4 py-2 rounded-lg text-xs font-mono border border-site hover:border-[var(--accent)] hover:text-accent transition-colors"
          >
            ./about
          </a>
          <a
            href="https://github.com/hsaraiya5"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-lg text-xs font-mono border border-site hover:border-[var(--accent)] hover:text-accent transition-colors"
          >
            ./github ↗
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-muted animate-bounce">
    <span class="text-xs font-mono">scroll</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</section>

<script>
  const roles = [
    'Backend Engineer',
    'MLOps Enthusiast',
    'Systems Thinker',
    'Type 1 Diabetic',
    'Sports Junkie',
    'Occasional Hiker',
  ];

  const el = document.getElementById('typewriter')!;
  const cursor = document.getElementById('cursor')!;

  let roleIndex = 0;
  let charIndex = 0;
  let deleting = false;

  // Blink cursor
  setInterval(() => {
    cursor.style.opacity = cursor.style.opacity === '0' ? '1' : '0';
  }, 530);

  function tick() {
    const current = roles[roleIndex];

    if (!deleting) {
      charIndex++;
      el.textContent = current.slice(0, charIndex);
      if (charIndex === current.length) {
        // Pause at end before deleting
        deleting = true;
        setTimeout(tick, 1800);
        return;
      }
      setTimeout(tick, 70);
    } else {
      charIndex--;
      el.textContent = current.slice(0, charIndex);
      if (charIndex === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        setTimeout(tick, 400);
        return;
      }
      setTimeout(tick, 35);
    }
  }

  // Start after a short delay
  setTimeout(tick, 800);
</script>
